# ── Server ──
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# ── Database (PostgreSQL) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thaliplan
DB_USER=postgres
DB_PASSWORD=change-me

# ── Auth ──
JWT_SECRET=generate-a-long-random-secret

# ── Payments (PhonePe / UPI) ──
UPI_VPA=yourvpa@bank
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# ── Email (Nodemailer SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Thali Plan <no-reply@example.com>

# ── SMS / WhatsApp (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Uploads ──
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
