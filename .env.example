# ── Server ──
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# ── Database (PostgreSQL) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thaliplan
DB_USER=postgres
DB_PASSWORD=change-me

# ── Auth ──
JWT_SECRET=generate-a-long-random-secret
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-something-strong

# ── AI food photo generation (menu items) ──
OPENAI_API_KEY=

# ── Payments (UPI / PhonePe / Razorpay / Paytm / Stripe) ──
UPI_VPA=yourvpa@bank
UPI_MERCHANT_NAME=ThaliPlan

# PhonePe
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Paytm
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=UAT

# Stripe (for international customers - cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Email (Nodemailer SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Thali Plan <no-reply@example.com>

# ── SMS / WhatsApp (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Uploads ──
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
