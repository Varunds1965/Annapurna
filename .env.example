# ── Server ─────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# ── Database (REQUIRED) ────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=thaliplan
DB_PASSWORD=          # REQUIRED — set a strong password
DB_PORT=5432
# Or use a connection string:
# DATABASE_URL=postgresql://user:pass@host:5432/thaliplan

# ── Auth (REQUIRED) ────────────────────────────
JWT_SECRET=           # REQUIRED — minimum 32 chars, use: openssl rand -hex 32
ADMIN_EMAIL=admin@thaliplan.com
ADMIN_PASSWORD=       # REQUIRED — strong password for admin login

# ── Email (SMTP) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=noreply@thaliplan.com

# ── SMS (Optional) ─────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=THALI
MSG91_TEMPLATE_ID=

# ── Twilio (Optional) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Payments ───────────────────────────────────
UPI_VPA=your-upi-id@bank
UPI_MERCHANT_NAME=ThaliPlan

# PhonePe
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Paytm
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Image uploads ──────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── AI Image Generation (Optional) ─────────────
OPENAI_API_KEY=

# ── Google Calendar (Optional) ──────────────────
# Place google-credentials.json in project root